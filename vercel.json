{
  "version": 2,
  "builds": [
    { "src": "app.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/contacta", "dest": "/app.js" },
    { "src": "/localizacion", "dest": "/app.js" },
    { "src": "/estilos/(.*)", "dest": "/public/estilos/$1" },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/", "dest": "/app.js" },
    { "src": "/(.*)", "dest": "/app.js" }
  ]
}